# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - GENERADOR DE PRESUPUESTOS
# Copia este archivo a `.env` y asigna tus claves reales
# ==============================================================================

# Proveedores de IA disponibles: "openai" o "groq"
LLM_PROVIDER=openai
TRANSCRIPTION_PROVIDER=openai

# Claves de API (puedes usar OpenAI, Groq o ambas)
OPENAI_API_KEY=tu_openai_api_key_aqui
GROQ_API_KEY=tu_groq_api_key_aqui

# Modelos recomendados:
# OpenAI: "gpt-4o-mini" o "gpt-4o" | Whisper: "whisper-1"
# Groq: "llama-3.3-70b-versatile"   | Whisper: "whisper-large-v3-turbo"
LLM_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1

# Datos Comerciales por Defecto de Tu Empresa
EMPRESA_NOMBRE=Soluciones Técnicas & Comerciales S.L.
EMPRESA_CIF=B-98765432
EMPRESA_DIRECCION=Calle Innovación 45, Planta 2, 28001 Madrid
EMPRESA_TELEFONO=+34 912 345 678
EMPRESA_EMAIL=contacto@solucionestecnicas.es
EMPRESA_WEB=www.solucionestecnicas.es
EMPRESA_IBAN=ES91 2100 0418 4502 0005 1332

# Configuración Financiera Predeterminada
DEFAULT_TAX_PERCENT=21.0
DEFAULT_CURRENCY=EUR
DEFAULT_VALIDITY_DAYS=15

# Configuración del Servidor
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

